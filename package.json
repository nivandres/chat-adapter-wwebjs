{
  "name": "chat-adapter-wwebjs",
  "version": "0.1.2",
  "description": "WhatsApp adapter for Chat SDK, backed by whatsapp-web.js",
  "author": "nivandres",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nivandres/chat-adapter-wwebjs.git"
  },
  "bugs": {
    "url": "https://github.com/nivandres/chat-adapter-wwebjs/issues"
  },
  "homepage": "https://github.com/nivandres/chat-adapter-wwebjs#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run typecheck:examples && bun run lint && bun run format:check && bun run test",
    "clean": "rm -rf dist",
    "typecheck:examples": "tsc --noEmit --project examples/tsconfig.json",
    "prepublishOnly": "bun run clean && bun run check && bun run build"
  },
  "peerDependencies": {
    "@chat-adapter/shared": "^4.40.0",
    "chat": "^4.40.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@chat-adapter/shared": "^4.40.0",
    "@chat-adapter/state-memory": "^4.40.0",
    "@chat-adapter/tests": "^4.40.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.0",
    "chat": "^4.40.0",
    "oxlint": "^1.61.0",
    "prettier": "^3.8.3",
    "qrcode-terminal": "^0.12.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js#064a3d5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "whatsapp",
    "whatsapp-web.js",
    "wwebjs"
  ]
}
